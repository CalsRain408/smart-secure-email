# Copy to deploy/.env and replace every value. Never commit deploy/.env.
# Generate secrets e.g. with: openssl rand -base64 24

DOMAIN_A_DB_USER=mail_a
DOMAIN_A_DB_PASSWORD=change-me
DOMAIN_A_REDIS_PASSWORD=change-me

DOMAIN_B_DB_USER=mail_b
DOMAIN_B_DB_PASSWORD=change-me
DOMAIN_B_REDIS_PASSWORD=change-me

# Shared HMAC secret between domain-a and domain-b (>= 32 bytes), e.g. openssl rand -base64 48
FEDERATION_SECRET_A_B=change-me-to-a-long-random-value-at-least-32-bytes
